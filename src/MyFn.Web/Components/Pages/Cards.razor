@page "/cartoes"
@inject ICreditCardService CardService
@inject NavigationManager Nav

<PageTitle>Cartões</PageTitle>
<div class="fn-page-head">
    <div>
        <div class="fn-kicker">Crédito</div>
        <h1>Cartões</h1>
    </div>
    <button class="btn-fn" @onclick="NewItem">+ Novo cartão</button>
</div>
@if (errors.Count > 0) { <div class="alert alert-danger">@string.Join(" ", errors)</div> }

<div class="row g-3">
    @foreach (var card in items)
    {
        <div class="col-lg-4">
            <div class="fn-card">
                <div class="d-flex justify-content-between">
                    <h2 class="h5">@card.Name</h2>
                    <StatusBadge Text="@(card.IsActive ? "Ativo" : "Inativo")" Tone="@(card.IsActive ? "ok" : "neutral")" />
                </div>
                <p class="text-muted">@card.Bank · fecha dia @card.ClosingDay · vence dia @card.DueDay</p>
                <div>Limite @Br.Money(card.Limit)</div>
                <div>Utilizado @Br.Money(card.UsedLimit)</div>
                <div>Disponível @Br.Money(card.AvailableLimit)</div>
                <div class="mt-2">Fatura atual (aberta) @Br.Money(card.CurrentInvoice)</div>
                <div class="mt-2">
                    Fatura fechada detalhada @Br.Money(card.ClosedInvoiceDetailed)
                    @if (card.ClosedInvoiceStatement is decimal statement)
                    {
                        <span> · banco @Br.Money(statement)</span>
                    }
                </div>
                <div class="mt-1"><StatusBadge Text="@Labels.InvoiceMatch(card.ClosedInvoiceStatus)" Tone="@(card.ClosedInvoiceStatus == InvoiceMatchStatus.Matched ? "ok" : card.ClosedInvoiceStatus == InvoiceMatchStatus.Over ? "bad" : card.ClosedInvoiceStatus == InvoiceMatchStatus.Pending ? "warn" : "neutral")" /></div>
                <h3 class="h6 mt-3">Próximas faturas</h3>
                @if (card.UpcomingInvoices.Count == 0)
                {
                    <p class="text-muted mb-0">Sem parcelas futuras.</p>
                }
                else
                {
                    <ul class="mb-2">
                        @foreach (var inv in card.UpcomingInvoices)
                        {
                            <li>@inv.Label — @Br.Money(inv.Amount)</li>
                        }
                    </ul>
                }
                <button class="btn btn-sm btn-link" @onclick="() => OpenInvoice(card.Id)">Conferir fatura</button>
                <button class="btn btn-sm btn-link" @onclick="() => Edit(card)">Editar</button>
                <button class="btn btn-sm btn-link text-danger" @onclick="() => AskDelete(card)">Excluir</button>
            </div>
        </div>
    }
</div>

<ModalFrame @bind-Visible="open" Title="Cartão">
    <div class="row g-2">
        <div class="col-md-6"><label class="form-label">Nome</label><InputText class="form-control" @bind-Value="form.Name" /></div>
        <div class="col-md-6"><label class="form-label">Banco</label><InputText class="form-control" @bind-Value="form.Bank" /></div>
        <div class="col-md-4"><label class="form-label">Limite</label><InputNumber class="form-control" @bind-Value="form.Limit" /></div>
        <div class="col-md-4"><label class="form-label">Fechamento</label><InputNumber class="form-control" @bind-Value="form.ClosingDay" /></div>
        <div class="col-md-4"><label class="form-label">Vencimento</label><InputNumber class="form-control" @bind-Value="form.DueDay" /></div>
        <div class="col-12"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="form.IsActive" /> Ativo</label></div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn-ghost" @onclick="() => open = false">Cancelar</button>
        <button class="btn-fn" @onclick="Save">Salvar</button>
    </div>
</ModalFrame>

<ConfirmDialog @bind-Visible="confirm" Title="Excluir cartão" ConfirmText="Excluir" OnConfirm="Delete">
    Excluir "@pending?.Name"? Se houver compras, o cartão será apenas desativado.
</ConfirmDialog>

@code {
    private List<CreditCardDto> items = [];
    private CreditCardDto form = new() { IsActive = true, ClosingDay = 10, DueDay = 17 };
    private CreditCardDto? pending;
    private bool open, confirm;
    private List<string> errors = [];

    protected override async Task OnInitializedAsync() => items = (await CardService.ListAsync()).ToList();

    private void OpenInvoice(Guid id) => Nav.NavigateTo($"/faturas/{id}");

    private void NewItem()
    {
        form = new CreditCardDto { IsActive = true, ClosingDay = 10, DueDay = 17 };
        open = true;
    }

    private void Edit(CreditCardDto card)
    {
        form = new CreditCardDto
        {
            Id = card.Id, Name = card.Name, Bank = card.Bank, Limit = card.Limit,
            ClosingDay = card.ClosingDay, DueDay = card.DueDay, IsActive = card.IsActive
        };
        open = true;
    }

    private async Task Save()
    {
        errors.Clear();
        try
        {
            await CardService.SaveAsync(form);
            items = (await CardService.ListAsync()).ToList();
            open = false;
        }
        catch (FinanceValidationException ex) { errors = ex.Errors.ToList(); }
    }

    private void AskDelete(CreditCardDto card) { pending = card; confirm = true; }
    private async Task Delete()
    {
        if (pending is null) return;
        await CardService.DeleteAsync(pending.Id);
        items = (await CardService.ListAsync()).ToList();
    }
}
