@page "/configuracoes"
@inject ISettingsService SettingsService

<PageTitle>Configurações</PageTitle>
<div class="fn-page-head">
    <div>
        <div class="fn-kicker">Preferências</div>
        <h1>Configurações</h1>
    </div>
</div>
@if (errors.Count > 0) { <div class="alert alert-danger">@string.Join(" ", errors)</div> }
@if (!string.IsNullOrEmpty(info)) { <div class="alert alert-success">@info</div> }

<div class="row g-3">
    <div class="col-lg-6">
        <div class="fn-card">
            <h2 class="h5">Financeiro</h2>
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">Salário padrão</label><InputNumber class="form-control" @bind-Value="form.DefaultSalary" /></div>
                <div class="col-md-6"><label class="form-label">Moeda</label><InputText class="form-control" @bind-Value="form.CurrencyCode" /></div>
                <div class="col-md-6"><label class="form-label">Primeiro dia do mês financeiro</label><InputNumber class="form-control" @bind-Value="form.FinancialMonthStartDay" /></div>
                <div class="col-md-6"><label class="form-label">Saudável até (%)</label><InputNumber class="form-control" @bind-Value="form.HealthyCommitmentMaxPercent" /></div>
                <div class="col-md-6"><label class="form-label">Atenção até (%)</label><InputNumber class="form-control" @bind-Value="form.WarningCommitmentMaxPercent" /></div>
                <div class="col-12"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="form.ShowDashboardCharts" /> Exibir gráficos no dashboard</label></div>
            </div>
            <button class="btn-fn mt-3" @onclick="Save">Salvar configurações</button>
        </div>
    </div>
    <div class="col-lg-6">
        <ExcelImportPanel />
    </div>
</div>

@code {
    private SettingsDto form = new();
    private List<string> errors = [];
    private string? info;

    protected override async Task OnInitializedAsync() => form = await SettingsService.GetAsync();

    private async Task Save()
    {
        await SettingsService.SaveAsync(form);
        info = "Configurações salvas.";
    }
}
