@page "/entradas"
@inject IIncomeService IncomeService
@inject ICategoryService Categories

<PageTitle>Entradas</PageTitle>
<div class="fn-page-head">
    <div>
        <div class="fn-kicker">Cadastro</div>
        <h1>Entradas</h1>
    </div>
    <button class="btn-fn" @onclick="() => Edit(new IncomeDto { Date = DateOnly.FromDateTime(DateTime.Today), CategoryId = cats.FirstOrDefault()?.Id ?? Guid.Empty })">+ Nova entrada</button>
</div>

@if (errors.Count > 0) { <div class="alert alert-danger">@string.Join(" ", errors)</div> }

<div class="fn-card">
    <table class="table fn-table">
        <thead><tr><th>Data</th><th>Descrição</th><th>Categoria</th><th>Recorrente</th><th class="text-end">Valor</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@Br.Date(item.Date)</td>
                <td>@item.Description</td>
                <td>@item.CategoryName</td>
                <td>@(item.IsRecurring ? "Sim" : "Não")</td>
                <td class="text-end pos">@Br.Money(item.Amount)</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-link" @onclick="() => Edit(item)">Editar</button>
                    <button class="btn btn-sm btn-link text-danger" @onclick="() => AskDelete(item)">Excluir</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<ModalFrame @bind-Visible="open" Title="Entrada">
    <EditForm Model="form" OnSubmit="Save">
        <div class="row g-2">
            <div class="col-12"><label class="form-label">Descrição</label><InputText class="form-control" @bind-Value="form.Description" /></div>
            <div class="col-md-6"><label class="form-label">Valor</label><InputNumber class="form-control" @bind-Value="form.Amount" /></div>
            <div class="col-md-6"><label class="form-label">Data</label><InputDate class="form-control" @bind-Value="form.Date" /></div>
            <div class="col-md-6">
                <label class="form-label">Categoria</label>
                <InputSelect class="form-select" @bind-Value="form.CategoryId">
                    @foreach (var c in cats) { <option value="@c.Id">@c.Name</option> }
                </InputSelect>
            </div>
            <div class="col-md-6 d-flex align-items-end"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="form.IsRecurring" /> Recorrente</label></div>
            @if (form.IsRecurring)
            {
                <div class="col-md-6"><label class="form-label">Término da recorrência</label><InputDate class="form-control" @bind-Value="form.RecurrenceEndDate" /></div>
            }
            <div class="col-12"><label class="form-label">Observação</label><InputTextArea class="form-control" @bind-Value="form.Notes" /></div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn-ghost" @onclick="() => open = false">Cancelar</button>
            <button type="submit" class="btn-fn">Salvar</button>
        </div>
    </EditForm>
</ModalFrame>

<ConfirmDialog @bind-Visible="confirm" Title="Excluir entrada" ConfirmText="Excluir" OnConfirm="Delete">
    Excluir "@pending?.Description"? Esta ação não pode ser desfeita.
</ConfirmDialog>

@code {
    private List<IncomeDto> items = [];
    private List<CategoryDto> cats = [];
    private IncomeDto form = new();
    private IncomeDto? pending;
    private bool open, confirm;
    private List<string> errors = [];

    protected override async Task OnInitializedAsync()
    {
        cats = (await Categories.ListAsync(CategoryType.Income, true)).ToList();
        items = (await IncomeService.ListAsync()).ToList();
    }

    private void Edit(IncomeDto dto)
    {
        form = new IncomeDto
        {
            Id = dto.Id, Description = dto.Description, Amount = dto.Amount, Date = dto.Date,
            CategoryId = dto.CategoryId, IsRecurring = dto.IsRecurring, RecurrenceEndDate = dto.RecurrenceEndDate, Notes = dto.Notes
        };
        open = true;
    }

    private async Task Save()
    {
        errors.Clear();
        try
        {
            await IncomeService.SaveAsync(form);
            items = (await IncomeService.ListAsync()).ToList();
            open = false;
        }
        catch (FinanceValidationException ex) { errors = ex.Errors.ToList(); }
    }

    private void AskDelete(IncomeDto item) { pending = item; confirm = true; }

    private async Task Delete()
    {
        if (pending is null) return;
        await IncomeService.DeleteAsync(pending.Id);
        items = (await IncomeService.ListAsync()).ToList();
    }
}
